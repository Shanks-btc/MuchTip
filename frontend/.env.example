# Copy to .env.local (gitignored) and fill in. EVERY value here is public: Vite puts VITE_* variables in the browser
# bundle. Never put Supabase's service key, the claim verifier's key, the X API token or any wallet key in this folder;
# `npm run check` and `npm run build` fail if one appears (scripts/secret-scan.mjs).

# Chain. Leave empty to use the live deployment (deployment.json): DogeOS Chikyu, TipEscrow 0x2076...aCeF.
VITE_CHAIN_ID=            # 6281971
VITE_RPC_URL=             # https://rpc.testnet.dogeos.com/
VITE_EXPLORER_URL=        # https://blockscout.testnet.dogeos.com
VITE_ESCROW_ADDRESS=      # 0x207652b0767F9f19d24B5300E2123D415167aCeF
VITE_ESCROW_DEPLOY_BLOCK= # 9065839

# Backend (docs/backend.md). Unset = the backend is "not connected": in dev, lookups and the feed use labelled demo
# data; in production builds those show as unavailable. Sign in with X needs both Supabase values.
VITE_SUPABASE_URL=        # https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=   # anon / publishable key ONLY
VITE_FUNCTIONS_URL=       # optional: defaults to <VITE_SUPABASE_URL>/functions/v1 (or a local `supabase functions serve` URL)

# Optional
VITE_REOWN_PROJECT_ID=    # WalletConnect; the WalletConnect option is hidden when empty
VITE_APP_ORIGIN=          # e.g. https://muchtip.vercel.app, used in share links; defaults to the page's own origin
