# Copy to supabase/functions/.env (gitignored) for `supabase functions serve --env-file supabase/functions/.env`, or set
# the same names with `supabase secrets set` for a hosted project. See docs/backend.md for what each one does.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase itself.

# --- the contract (all three functions that touch the chain) -------------------------------------------------------
ESCROW_ADDRESS=0x207652b0767F9f19d24B5300E2123D415167aCeF
ESCROW_DEPLOY_BLOCK=9065839            # feed: where an empty index starts scanning
RPC_URL=https://rpc.testnet.dogeos.com/
CHAIN_ID=6281971

# --- secrets -------------------------------------------------------------------------------------------------------
VERIFIER_PRIVATE_KEY=                  # sign-claim. SECRET. Its address must equal TipEscrow.verifier()
X_BEARER_TOKEN=                        # resolve. SECRET. Leave EMPTY ONLY in development: unset = mock fixtures

# --- optional tuning (defaults shown) ------------------------------------------------------------------------------
# CORS_ALLOW_ORIGIN=*                  # set to your app's origin in production
# CLAIM_TTL_SECONDS=300                # signature validity, counted from the latest block's timestamp
# SIGN_CLAIM_USER_PER_10MIN=10         # per X account
# SIGN_CLAIM_IP_PER_10MIN=60
# RESOLVE_CACHE_TTL_SECONDS=3600
# RESOLVE_RATE_PER_MINUTE=30           # per client IP
# RESOLVE_FRESH_PER_MINUTE=10          # per client IP, fresh lookups only (each is a paid X call)
# X_API_BUDGET_PER_15MIN=280           # all callers together; X allows 300 / 15 min per app
# FEED_RATE_PER_MINUTE=120
# FEED_MIN_SYNC_SECONDS=5
# FEED_MAX_BLOCKS_PER_SYNC=100000
# FEED_LOG_CHUNK_BLOCKS=9000           # DogeOS caps eth_getLogs at 10,000 blocks
# FEED_CONFIRMATIONS=0
# FEED_LEASE_SECONDS=30                # single-writer lease for the indexer, renewed per stored chunk
# SERVICE_ROLE_KEY=                    # only if the platform does not inject SUPABASE_SERVICE_ROLE_KEY
# X_API_BASE_URL=                      # TESTS ONLY: points `resolve` at a fake X API
